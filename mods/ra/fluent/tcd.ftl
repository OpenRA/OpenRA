## Tactics & Command Dynamics

hotkey-description-formsquad = Form Squad
hotkey-description-disbandsquad = Disband Squad
hotkey-description-formationpoints = Formation: mark a shape
hotkey-description-formationdraw = Formation: draw a line

button-tcd-toggle =
    .tooltip = Squads & Formations
    .tooltipdesc = Show or hide the squad and formation buttons.

button-squad-bar-form =
    .tooltip = Form Squad
    .tooltipdesc = Group the selected units into a squad. Clicking any member then selects the whole squad. Hold Alt to select just one.

button-squad-bar-disband =
    .tooltip = Disband Squad
    .tooltipdesc = Break up the squads containing the selected units.

button-formation-grid =
    .tooltip = Rectangle Formation
    .tooltipdesc = A tight block as close to square as the count allows. Six units make two rows of three.

button-formation-wedge =
    .tooltip = Triangle Formation
    .tooltipdesc = A tight arrowhead with the front rank at the tip.

button-formation-line =
    .tooltip = Draw a Line
    .tooltipdesc = Drag a straight line on the map and the selected units space themselves along it. Same as holding V.

button-formation-shape =
    .tooltip = Mark a Shape
    .tooltipdesc = Right click to mark corners, then press this again to close the shape and place the units. Same as holding G.
