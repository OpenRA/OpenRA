## infantry.yaml
actor-e1 =
    .name = 機槍兵
    .description = 通用步兵。 擅長對抗步兵 弱於載具
    .encyclopedia = 不起眼的機槍兵是高度專業的步兵，用來承受傷害並消滅其他步兵。 和大多數泰伯倫黎明單位一樣，他們的視野比射程更遠，成群使用時很適合清除敵方步兵。

actor-e2 =
    .name = 擲彈兵
    .description = 投擲手榴彈的快速步兵。 擅長對抗建築與慢速目標
    .encyclopedia = 速度快，跟得上中型坦克，因此很適合配合側翼部隊。 火力雖不如機槍兵或火箭兵，但速度可以成為你的優勢。

actor-e3 =
    .name = 火箭兵
    .description = 反坦克、防空步兵。 擅長對抗坦克與飛行器 弱於步兵
    .encyclopedia = 非常脆弱，但極擅長消滅敵方裝甲與飛行器。它是遊戲中最慢的單位，比其他步兵甚至巨象坦克還慢。 較長的武器射程彌補了緩慢的速度，最適合用於防禦，以便受到保護並提供視野。

actor-e4 =
    .name = 噴火兵
    .description = 高級反步兵單位。 擅長對抗步兵與建築 弱於坦克
    .encyclopedia = 適合側翼突擊並燒毀建築。生命值比一般機槍兵更高，但武器射程短，難以編入大規模部隊。

actor-e5 =
    .name = 化學戰士
    .description = 高級通用步兵。 擅長對抗所有地面單位
    .encyclopedia = 能力與噴火兵相近，但對重甲的傷害不錯。很適合阻止敵方裝甲碾過你的部隊。 可以走在泰伯倫上而不受傷，在某些地圖上特別適合騷擾採收車。

actor-e6 =
    .name = 工程師
    .description = 破壞並佔領敵方建築。 修復已摧毀的載具。 無武裝
    .encyclopedia = 和火箭兵一樣，工程師速度慢，需要護航才能有效運用。可以立即佔領建築，但本人會在過程中消耗掉。 佔領平民建築只需要一名工程師；佔領敵方建築通常需要兩名，若建築受損嚴重，則一名即可。 工程師也可以修復友方建築，或把已摧毀載具的殘骸修復回來。

actor-rmbo =
    .name = 突擊兵
    .description = 精英狙擊步兵。 擅長對抗步兵與建築 弱於載具
    .encyclopedia = 配備長程狙擊槍，射速慢，但在充分支援下能從遠處消滅敵方步兵。 攜帶 C4，可出其不意地從後方炸毀建築。

actor-pvice =
    .description = 噴吐液態泰伯倫的變異怪物。 擅長對抗步兵與建築 弱於飛行器
    .encyclopedia = 泰伯倫的奇異特性會產生這種變異生物，步兵單位暴露其中就會變成這樣。牠們的生命值恢復很快，並擁有短程泰伯倫武器。

actor-steg =
    .name = 劍龍
    .description = 體型龐大、身軀厚實的 草食四足動物。

actor-trex =
    .name = 暴龍
    .description = 擁有巨大頭骨的 雙足肉食動物。

actor-tric =
    .name = 三角龍
    .description = 有大型骨質頭盾 與三隻角的四足動物。

actor-rapt =
    .name = 迅猛龍
    .description = 雙足行走，每隻後腳 有一支增大的鐮狀爪。

