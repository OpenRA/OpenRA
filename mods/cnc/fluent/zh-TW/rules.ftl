actor-fact =
    .name = 建造廠
    .description = 建造建築。
    .encyclopedia = 任何基地的核心。生產建築與防禦工事，並提供建造範圍。生命值很高，但難以替換，因此務必加以防守。 按下部署鍵可將它轉為機動形態，但需要一點時間。

actor-fact-gdi-name = 全球防衛組織建造廠
actor-fact-nod-name = 諾德兄弟會建造廠

actor-nuke =
    .name = 發電廠
    .description = 產生電力。
    .encyclopedia = 為基地內的建築供電。發電量與發電廠的受損程度直接相關，戰鬥時請保護它們。

actor-nuk2 =
    .name = 高級發電廠
    .description = 提供更多電力，比標準 發電廠更便宜。
    .encyclopedia = 為基地內的建築提供更多電力，比發電廠更划算。發電量與其受損程度直接相關，戰鬥時請加以保護。

actor-proc =
    .name = 泰伯倫精煉廠
    .description = 將原始泰伯倫 處理成可用資源。
    .encyclopedia = 儲存並處理外星物質資源泰伯倫。採收車在野外收集泰伯倫，送到精煉廠後轉換成資金。 精煉廠會儲存泰伯倫，建造完成後立即派出一輛採收車。近處精煉最多可應付 3 輛採收車。

actor-silo =
    .name = 泰伯倫儲存槽
    .description = 儲存處理後的泰伯倫。
    .encyclopedia = 儲存資金。若儲存空間已滿，採收車會等到資金花掉後才繼續作業。 採集價值較高的藍色泰伯倫時特別有用，因為單一精煉廠存不下一整車的產量。

actor-pyle =
    .name = 兵營
    .description = 訓練步兵。
    .encyclopedia = 為全球防衛組織生產步兵。解鎖後，全球防衛組織的高級步兵火力強且速度快。

actor-hand =
    .name = 諾德之手
    .description = 訓練步兵。
    .encyclopedia = 為諾德兄弟會生產步兵。解鎖後，諾德兄弟會的高級步兵速度慢，但生命值很高。

actor-afld =
    .name = 簡易機場
    .description = 提供載具援軍的 空投區。
    .encyclopedia = 以飛機為諾德兄弟會運送載具。諾德兄弟會的載具速度快但脆弱。開局先造採收車，以便快速啟動經濟。

actor-weap =
    .name = 武器工廠
    .description = 生產載具。
    .encyclopedia = 為全球防衛組織生產載具。全球防衛組織的載具往往速度慢但火力強。開局先造採收車，以便快速啟動經濟。

actor-hpad =
    .name = 直升機坪
    .description = 生產並修復直升機。
    .encyclopedia = 生產並修復直升機。建造高級攻擊直升機需要通訊中心。

actor-hq =
    .name = 通訊中心
    .description = 提供雷達與空襲支援能力。 解鎖更高科技的單位與建築。 運作需要電力。
    .airstrikepower-name = 空襲
    .airstrikepower-description = 發動空中汽油彈打擊。 沿直線燒毀建築與步兵。
    .encyclopedia = 電力充足時可使用小地圖（右上角）。解鎖新單位，並提供空襲支援能力。

actor-fix =
    .name = 維修廠
    .description = 修復載具。
    .encyclopedia = 修復載具。對單位下達修復指令後，會前往最近的維修廠。

actor-eye =
    .name = 高級通訊中心
    .description = 提供雷達與軌道離子砲支援能力。 解鎖巨象坦克與突擊兵。 運作需要電力。
    .ioncannonpower-name = 離子砲
    .ioncannonpower-description = 發動離子砲打擊。 對小範圍造成立即傷害。
    .encyclopedia = 解鎖高級單位與離子砲支援能力。若通訊中心被毀，它會恢復小地圖功能與單位生產。

actor-tmpl =
    .name = 諾德神殿
    .description = 提供核子飛彈支援能力。 解鎖隱形坦克、化學戰士與光之方尖碑。 運作需要電力。
    .nukepower-name = 核子飛彈
    .nukepower-description = 發射戰術核子飛彈。 對大範圍造成沉重傷害。
    .encyclopedia = 解鎖高級單位與核子飛彈支援能力。若通訊中心被毀，單位解鎖仍然有效。

actor-gun =
    .name = 砲塔
    .description = 基礎反坦克基地防禦。 擅長對抗坦克與載具 弱於步兵
    .encyclopedia = 配備穿甲砲的基地防禦，對射程內的載具造成可觀傷害。

actor-sam =
    .name = 防空飛彈
    .description = 防空基地防禦。 擅長對抗飛行器 無法鎖定地面單位
    .encyclopedia = 諾德兄弟會的防空基地防禦。關閉時受到保護，開啟後攻擊飛行器。

actor-obli =
    .name = 光之方尖碑
    .description = 高級基地防禦。 運作需要電力。 擅長對抗所有地面單位 無法鎖定飛行器
    .encyclopedia = 諾德兄弟會的高級防禦，以強力雷射迅速摧毀地面目標。

actor-gtwr =
    .name = 防禦塔
    .description = 基礎防禦建築。 擅長對抗步兵 弱於坦克
    .encyclopedia = 配備高速機槍的基地防禦，射界寬廣，能撕裂射程內的步兵與輕型載具。

actor-atwr =
    .name = 高級防禦塔
    .description = 全方位防禦建築。 擅長對抗飛行器與步兵 弱於坦克
    .encyclopedia = 全球防衛組織的高級防禦，對地面與空中目標發射高爆飛彈齊射。對各種目標都有效。

actor-sbag =
    .name = 沙包障礙
    .description = 阻擋步兵與輕型載具。 可被坦克碾過。
    .encyclopedia = 阻擋步兵與輕型載具移動，但可被坦克碾過。免疫輕武器火力。 放下一節沙包後，此障礙可以一次建造多段。

actor-cycl =
    .name = 鐵絲網障礙
    .description = 阻擋步兵與輕型載具。 可被坦克碾過。
    .encyclopedia = 阻擋步兵與輕型載具移動，但可被坦克碾過。免疫輕武器火力。 放下第一段鐵絲網後，此障礙可以一次建造多段。

actor-brik =
    .name = 混凝土障礙
    .description = 阻擋步兵與大多數坦克。 可阻擋部分投射物。
    .encyclopedia = 阻擋所有單位移動，但巨象坦克可以碾過。免疫輕武器火力。 放下第一段牆後，此障礙可以一次建造多段。

