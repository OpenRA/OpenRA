## vehicles.yaml
actor-mcv =
    .name = 機動建造車
    .description = 部署成建造廠。 無武裝
    .encyclopedia = 把機動建造車部署後，會變成建造廠。展開後的生命值更高，但收回有助於逃離步兵。 若有隊友，他們可以在你的基地附近摧毀尚未部署的機動建造車，把它「贈送」給你，再由工程師收回。

actor-harv =
    .name = 採收車
    .generic-name = 採收車
    .description = 收集泰伯倫以供處理。 無武裝
    .encyclopedia = 採收車會緩慢開採泰伯倫，並送回精煉廠轉換成資金。也可以送到盟友的精煉廠，為對方提供資金。

notification-harvester-lost = 採收車損失。

actor-apc =
    .name = 裝甲運兵車
    .description = 武裝步兵運輸車。 可以攻擊飛行器。 擅長對抗載具 弱於步兵
    .encyclopedia = 裝甲運兵車用來運送步兵，方便佔領平民建築。它的防空砲對敵方載具傷害不高，但能承受敵火，讓悍馬車負責輸出傷害。 它也是主要的對空單位；下達停止指令後，會重新鎖定附近的敵方空中單位。

actor-arty =
    .name = 自走砲
    .description = 遠程自走砲。 擅長對抗步兵、載具與建築
    .encyclopedia = 諾德兄弟會的自走砲火力強但非常脆弱，能在遠距離造成大量傷害。對建築與步兵特別有效，也能摧毀靜止的坦克。 聚在一起時很危險，因為被摧毀時會爆炸。

actor-ftnk =
    .name = 火焰坦克
    .description = 重裝甲噴火載具。 擅長對抗步兵、建築與載具 弱於坦克
    .encyclopedia = 能燒燬步兵與建築，很適合奇襲。小心它們被摧毀時的濺射傷害，但這也能加以利用。

actor-bggy =
    .name = 諾德越野車
    .description = 快速偵察與反步兵載具。 擅長對抗步兵 弱於坦克
    .encyclopedia = 擅長對付輕型載具與步兵，越野車很適合偵察並消滅落單步兵。雖然比全球防衛組織的悍馬車便宜一些、也更快，但更脆弱。

actor-bike =
    .name = 偵察摩托車
    .description = 搭載火箭的快速偵察載具。 可以攻擊飛行器。 擅長對抗載具與坦克 弱於步兵
    .encyclopedia = 諾德兄弟會的摩托車非常快，配備穿甲火箭，很適合打了就跑以及騷擾採收車。 注意它的火箭速度慢，難以命中快速移動的目標。

actor-jeep =
    .name = 悍馬車
    .description = 快速偵察與反步兵載具。 擅長對抗步兵 弱於坦克
    .encyclopedia = 擅長對付輕型載具與步兵，悍馬車很適合偵察並消滅落單步兵。 對付大量諾德兄弟會摩托車時非常出色，這種交戰應建造悍馬車，而不是坦克。雖然比諾德越野車稍慢，但生命值更高。

actor-ltnk =
    .name = 輕型坦克
    .description = 快速的輕型坦克。 擅長對抗載具與坦克 弱於步兵
    .encyclopedia = 輕型坦克速度快、生命值高，儘管輸出不高，仍很適合在各種編制中擔任前線。 面對中型坦克時，應與偵察摩托車、隱形坦克或步兵搭配。

actor-mtnk =
    .name = 中型坦克
    .description = 全球防衛組織的通用坦克。 擅長對抗坦克與載具 弱於步兵
    .encyclopedia = 全球防衛組織的主力，在速度、耐久與火力之間取得良好平衡。能輕易摧毀諾德兄弟會的輕型坦克，若潛入基地也能撕開建築。 在中型坦克部隊中混編機槍兵，以對付敵方步兵。

actor-htnk =
    .name = 巨象坦克
    .description = 全球防衛組織的重裝甲坦克。 可以攻擊飛行器。 擅長對抗所有目標
    .encyclopedia = 一座緩緩前進的戰鬥堡壘，能夠自我修復並應付任何威脅。對敵方裝甲特別有效，也能消滅少量步兵或飛行器。 進入敵方基地時，將它設為攻擊任何目標姿態，讓它在移動時開出一條破壞之路。

actor-msam =
    .name = 火箭發射車
    .description = 遠程火箭砲。 擅長對抗所有地面單位
    .encyclopedia = 玩家常稱為「MLRS」（多管火箭系統）。這座砲兵平台對遠方目標發射火箭齊射。對輕型載具特別有效，對步兵、建築與重甲也有中等傷害。 用來對付敵方自走砲很強。彈速快，且對輕型載具傷害高，是諾德兄弟會自走砲的理想克星。

actor-mlrs =
    .name = 移動防空飛彈
    .description = 強力對空單位。 無法攻擊地面單位。
    .encyclopedia = 玩家通常稱為「MSAM」。當偵察摩托車不夠用時，這輛諾德兄弟會載具是專門的對空單位。它發射飛行緩慢、濺射傷害強大的飛彈。

actor-stnk =
    .name = 隱形坦克
    .description = 可隱形的遠程飛彈坦克。 可以攻擊飛行器。 裝甲薄弱。可被步兵與 防禦建築發現。 擅長對抗載具與坦克 弱於步兵
    .encyclopedia = 隱形單位在受傷或開火時會現形。小範圍內的防禦工事，或距離一格的步兵，也能發現它們。 遠程穿甲飛彈很適合對付敵方裝甲或空中單位。緊急時也能碾過步兵。

actor-mhq =
    .name = 移動指揮部
    .description = 移動的作戰基地。

actor-truck =
    .name = 補給卡車
    .description = 運送資金給其他玩家。 建造迅速 無武裝
    .encyclopedia = 盟友沒錢，或你的資金花不完時，補給卡車是方便的分享方式。它們的建造速度比造價看起來快得多。

