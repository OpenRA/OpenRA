button-command-bar-attack-move =
    .tooltip = 攻擊移動
    .tooltipdesc = 選取的單位會移動到指定位置， 並攻擊沿途遇到的任何敵人。 指定目標時按住 <(Ctrl)>，可下令強襲移動， 沿途攻擊遇到的任何單位或建築。 先以左鍵點選圖示，再對目標位置按右鍵。

button-command-bar-force-move =
    .tooltip = 強制移動
    .tooltipdesc = 選取的單位會移動到指定位置 - 會抑制目標的預設動作 - 載具會試圖碾過目標位置的敵人 - 直升機會在目標位置降落 先以左鍵點選圖示，再對目標按右鍵。 指揮單位時按住 <(Alt)> 可暫時啟用。

button-command-bar-force-attack =
    .tooltip = 強制攻擊
    .tooltipdesc = 選取的單位會攻擊鎖定的單位或位置 - 會抑制目標的預設動作 - 可以鎖定己方或盟友的部隊 - 遠程自走砲單位一律鎖定該 位置，忽略單位與建築 先以左鍵點選圖示，再對目標按右鍵。 指揮單位時按住 <(Ctrl)> 可暫時啟用。

button-command-bar-guard =
    .tooltip = 警戒
    .tooltipdesc = 選取的單位會跟隨鎖定的單位。 先以左鍵點選圖示，再對目標單位按右鍵。

button-command-bar-deploy =
    .tooltip = 部署
    .tooltipdesc = 選取的單位會執行預設的部署動作 - 機動建造車會展開成建造廠 - 建造廠會收回成機動建造車 - 運輸載具會卸下乘客 立刻對選取的單位生效。

button-command-bar-scatter =
    .tooltip = 散開
    .tooltipdesc = 選取的單位會停止目前動作， 並移動到附近位置。 立刻對選取的單位生效。

button-command-bar-stop =
    .tooltip = 停止
    .tooltipdesc = 選取的單位會停止目前動作。 選取的建築會重設集結點。 立刻對選取的目標生效。

button-command-bar-queue-orders =
    .tooltip = 路徑點模式
    .tooltipdesc = 用路徑點模式對選取的單位下達多個連續指令。 單位收到指令後會立即執行。 先以左鍵點選圖示，再在遊戲世界中下達指令。 指揮單位時按住 <(Shift)> 可暫時啟用。

button-stance-bar-attackanything =
    .tooltip = 攻擊任何目標姿態
    .tooltipdesc = 將選取的單位設為攻擊任何目標姿態： - 單位看見敵方單位與建築就會攻擊 - 單位會跨越戰場追擊攻擊者

button-stance-bar-defend =
    .tooltip = 防禦姿態
    .tooltipdesc = 將選取的單位設為防禦姿態： - 單位看見敵方單位就會攻擊 - 單位不會移動或追擊敵人

button-stance-bar-returnfire =
    .tooltip = 還擊姿態
    .tooltipdesc = 將選取的單位設為還擊姿態： - 單位會反擊攻擊自己的敵人 - 單位不會移動或追擊敵人

button-stance-bar-holdfire =
    .tooltip = 停火姿態
    .tooltipdesc = 將選取的單位設為停火姿態： - 單位不會對敵人開火 - 單位不會移動或追擊敵人

