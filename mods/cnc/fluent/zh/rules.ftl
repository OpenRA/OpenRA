actor-fact =
    .name = 建造区
    .description = 建造建筑。
    .encyclopedia =
    任何基地的核心。它产生建筑和防御设施，同时提供建造半径。它具有大量生命值，但难以替换，使其成为保护的头等大事。

    它可以使用部署键转换为移动版本，但这需要一小段时间。

actor-fact-gdi-name = GDI建造区
actor-fact-nod-name = Nod建造区

actor-nuke =
    .name = 发电厂
    .description = 产生电力。
    .encyclopedia =
    为基地内的建筑提供电力。电力输出与电厂的状况直接相关，因此在战斗中保护它们。

actor-nuk2 =
    .name = 先进发电厂
    .description =
    提供更多电力，比标准
    发电厂更便宜。
    .encyclopedia =
    为基地内的建筑提供更多的电力，使其比电厂更具有成本效益。电力输出与电厂状况直接相关，因此在战斗中保护它。

actor-proc =
    .name = 钛菌精炼厂
    .description =
    处理原始钛菌
    成可使用的资源。
    .encyclopedia =
    储存和处理外星材料和资源，钛菌。收割者在田地里收集钛菌并将其储存在精炼厂中，在那里转化为信用点。

    精炼厂储存钛菌并立即在建造完成后部署一个收割者。3个收割者是它可以处理的闭合作精炼最大数。

actor-silo =
    .name = 钛菌筒仓
    .description = 储存已处理的钛菌。
    .encyclopedia =
    储存信用点。如果储储满，收割者将等待到信用点花完。

    在收割更贵的蓝色钛菌时很有用，因为单个精炼厂无法储存满载。

actor-pyle =
    .name = 兵营
    .description = 训练步兵。
    .encyclopedia =
    为GDI生产步兵。一旦解锁，先进的GDI步兵就是具有打击力和速度快的。

actor-hand =
    .name = Nod之手
    .description = 训练步兵。
    .encyclopedia =
    为Nod生产步兵。一旦解锁，先进的Nod步兵速度较慢但拥有高生命值。

actor-afld =
    .name = 跑道
    .description =
    为载具增援提供
    降落区。
    .encyclopedia =
    通过飞机提供载具。Nod载具速度快但脆弱。在开始时生产收割者以启动你的经济。

actor-weap =
    .name = 武器工厂
    .description = 生产载具。
    .encyclopedia =
    为GDI生产载具。GDI载具通常较慢但打击有力。在开始时生产收割者以启动你的经济。

actor-hpad =
    .name = 直升机平台
    .description =
    生产和修理直升机。
    .encyclopedia =
    生产和修理直升机。需要通讯中心才能建造高级攻击直升机。

actor-hq =
    .name = 通讯中心
    .description =
    提供雷达和空袭支援能力。
    解锁更先进的单位和建筑。
    需要电力来运行。
    .airstrikepower-name = 空袭
    .airstrikepower-description = 部署空中凝固汽油弹打击。
    燃烧建筑和步兵，沿着一条线。
    .encyclopedia =
    为玩家提供小地图（右上）访问权限，当电力充足时。解锁新单位，同时授予空袭支援能力。

actor-fix =
    .name = 维修设施
    .description = 修理载具。
    .encyclopedia =
    修理载具。修理命令可以用于单位，以便将其发送到最近的维修设施。

actor-eye =
    .name = 先进通讯中心
    .description =
    提供雷达和轨道离子加农炮支援能力。
    解锁巨兽坦克和突击兵。
    需要电力来运行。
    .ioncannonpower-name = 离子加农炮
    .ioncannonpower-description = 启动离子加农炮打击。
    对一小块区域施加即时伤害。
    .encyclopedia =
    解锁先进单位和离子加农炮支援能力。如果通讯中心丢失，它将恢复小地图功能和单位生产。

actor-tmpl =
    .name = Nod神庙
    .description =
    提供核打击支援能力。
    解锁隐形坦克，化学战士和光之方尖碑。
    需要电力来运行。
    .nukepower-name = 核打击
    .nukepower-description = 发射战术核弹头。
    在大区域内造成沉重伤害。
    .encyclopedia =
    解锁先进单位和核打击支援能力。如果通讯中心丢失，它将在线保持单位解锁。

actor-gun =
    .name = 炮塔
    .description =
    基础反坦克基地防御。
      强于坦克和载具
      弱于步兵
    .encyclopedia =
    基础防御装备有穿甲炮，对范围内的载具造成重大伤害。

actor-sam =
    .name = 萨姆导弹
    .description =
    反飞机基地防御。
      强于飞机
      无法攻击地面单位
    .encyclopedia =
    Nod反飞机基地防御。当关闭时受到保护并开放来攻击飞机。

actor-obli =
    .name = 光之方尖碑
    .description =
    先进基地防御。
    需要电力来运行。
      强于所有地面单位
      无法攻击飞机
    .encyclopedia =
    Nod的新型防御，用强大的激光快速摧毁地面目标。

actor-gtwr =
    .name = 守卫塔
    .description =
    基础防御建筑。
      强于步兵
      弱于坦克
    .encyclopedia =
    基础防御装备有高射速机枪，对范围内的步兵和轻型载具造成大区域效果的伤害。

actor-atwr =
    .name = 先进守卫塔
    .description =
    全能型防御建筑。
      强于飞机和步兵
      弱于坦克
    .encyclopedia =
    GDI的先进防御，对空和地目标发射高爆 missile，对所有单位都很有效。

actor-sbag =
    .name = 沙袋屏障
    .description =
    阻挡步兵和轻型载具。
      可被坦克压毁。
    .encyclopedia =
    阻挡步兵和轻型载具移动，但可被坦克压毁。不受轻武器火力影响。

    这种屏障可以一次初始沙袋放置后，建造多个段。

actor-cycl =
    .name = 链条屏障
    .description =
    阻挡步兵和轻型载具。
      可被坦克压毁。
    .encyclopedia =
    阻挡步兵和轻型载具移动，但可被坦克压毁。不受轻武器火力影响。

    这种屏障可以一次初始链段放置后，建造多个段。

actor-brik =
    .name = 混凝土屏障
    .description =
    阻挡步兵和大部分坦克。
    阻挡一些弹丸。
    .encyclopedia =
    阻挡所有单位的移动，除了巨兽坦克可以压毁它。不受轻武器火力影响。

    这种屏障可以一次初始墙壁放置后，建造多个段。

